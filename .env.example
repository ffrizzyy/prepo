# Leave DATABASE_URL unset to run on PGlite (real Postgres in WASM, no container).
# Set it to use the docker-compose Postgres or Neon:
# DATABASE_URL=postgres://prepo:prepo@localhost:5432/prepo

# Where the embedded PGlite database keeps its files.
# PGLITE_DIR=.pglite

# Audio storage (milestone 4). Defaults live under apps/web/.storage, which is
# git-ignored. The local filesystem driver is the only one implemented; the
# interface is there so an object store can replace it later.
# AUDIO_STORAGE_DIR=.storage/audio
# AUDIO_STAGING_DIR=.storage/incoming

# Speech-to-text. With no key, recordings are still stored and the transcript
# upload/paste route works, but nothing is sent anywhere and the UI says so.
# DEEPGRAM_API_KEY=
# Optional, so cost is only recorded when you know your own rate:
# DEEPGRAM_COST_PER_MINUTE=

# Not built yet — extraction (milestone 7) is what needs a language model.
# ANTHROPIC_API_KEY=

# Not built yet — Linear sync is milestone 6.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
